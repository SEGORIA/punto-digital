{
  "name": "punto-digital",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @punto-digital/db generate",
    "db:migrate": "pnpm --filter @punto-digital/db migrate",
    "postinstall": "pnpm --filter @punto-digital/db generate"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20"
  }
}
