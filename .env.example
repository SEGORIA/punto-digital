# Base de datos
# En Neon: DATABASE_URL = connection string "pooled" (host con "-pooler"),
# DIRECT_DATABASE_URL = connection string directa (sin pooler), usada solo para migraciones.
DATABASE_URL="postgresql://user:password@localhost:5432/puntodigital"
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/puntodigital"

# API interna para integración con el futuro sistema de gestión (ERP)
INTERNAL_API_KEY="changeme-generate-a-strong-random-key"

# Auth admin
NEXTAUTH_SECRET="changeme-generate-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Pasarela de pagos (Mercado Pago - igual que puntodigitalstore.com.co en producción)
MP_ACCESS_TOKEN=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

# Almacenamiento de imágenes (S3-compatible, ej. Cloudflare R2)
# Si se dejan vacías, el uploader guarda en el filesystem local (solo sirve en dev,
# no persiste en hosting serverless como Vercel).
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PUBLIC_URL=""
